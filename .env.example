# Heritage monorepo — single local env file (copy to `.env` at this same path).
# Do not use apps/api/.env or apps/web/.env; apps load this file automatically.

# --- Docker Compose (Postgres, local dev) ---
POSTGRES_USER=heritage
POSTGRES_PASSWORD=heritage_dev
POSTGRES_DB=heritage
POSTGRES_PORT=5432

# --- API (NestJS, apps/api) ---
PORT=4000
DATABASE_URL=postgresql://heritage:heritage_dev@localhost:5432/heritage?schema=public
UPLOAD_DIR=uploads
PUBLIC_ASSET_BASE_URL=http://localhost:4000
PUBLIC_WEB_BASE_URL=https://heritage.nobatix.ir
JWT_SECRET=dev-only-change-me-please-use-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000

# --- Web (Next.js, apps/web) ---
# Server-side API base (rewrites /api/v1 to Nest).
API_BASE_URL=http://localhost:4000/api/v1
# Public site origin (QR codes, canonical URLs).
NEXT_PUBLIC_SITE_URL=https://heritage.nobatix.ir
# Admin Map.ir coordinate picker (restrict by domain in Map.ir dashboard).
NEXT_PUBLIC_MAP_IR_API_KEY=
