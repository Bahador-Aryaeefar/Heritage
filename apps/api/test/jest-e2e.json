{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "commonjs",
          "moduleResolution": "node",
          "resolvePackageJsonExports": false
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^@heritage/shared-types$": "<rootDir>/../../packages/shared-types/src/index.ts",
    "^@heritage/env-loader$": "<rootDir>/../../packages/env-loader/src/index.ts"
  },
  "transformIgnorePatterns": ["/node_modules/"]
}
