{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@heritage/shared-types$": "<rootDir>/../../packages/shared-types/src/index.ts"
  },
  "transformIgnorePatterns": ["/node_modules/"]
}
