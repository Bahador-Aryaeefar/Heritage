// Kermanshah Heritage - Prisma schema.
// See heritage-schema-map.md and architecture-decisions.md §7 / §14.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteCategory {
  HISTORICAL
  HANDICRAFT
  STREET
  LANDMARK
  FOOD
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum ContentBlockType {
  HEADING
  PARAGRAPH
  LIST
  IMAGE
  VIDEO
  AUDIO
}

enum ListStyle {
  BULLET
  NUMBERED
}

enum TextRole {
  HERO
  H2
  H3
  BODY
  CAPTION
}

enum ColorToken {
  BROWN_950
  BROWN_800
  BROWN_600
  TEAL_700
  SAND_50
}

enum BlockAlign {
  START
  CENTER
  END
}

enum VisitSource {
  QR
  WEB
}

enum UserRole {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

model Province {
  id        String   @id @default(cuid())
  nameFa    String
  nameEn    String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
}

model City {
  id         String   @id @default(cuid())
  provinceId String
  nameFa     String
  nameEn     String
  slug       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  sites      Site[]

  @@index([provinceId])
}

model Site {
  id           String             @id @default(cuid())
  slug         String             @unique
  category     SiteCategory
  lat          Decimal?           @db.Decimal(10, 7)
  lng          Decimal?           @db.Decimal(10, 7)
  cityId       String
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  city         City               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  translations SiteTranslation[]
  media        Media[]
  blocks       SiteContentBlock[]
  qrCodes      QRCode[]
  visitEvents  VisitEvent[]
  reviews      SiteReview[]

  @@index([cityId])
  @@index([isActive])
}

model SiteTranslation {
  id               String   @id @default(cuid())
  siteId           String
  locale           String   @db.VarChar(5)
  title            String
  shortDescription String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, locale])
  @@index([siteId])
}

model Media {
  id          String     @id @default(cuid())
  siteId      String
  type        MediaType
  url         String?
  embedUrl    String?
  mimeType    String?
  contentHash String?
  durationSec Int?
  sortOrder   Int        @default(0)
  isCover     Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  blocks      SiteContentBlock[]

  @@index([siteId])
  @@index([siteId, isCover])
  @@index([siteId, contentHash])
}

model SiteContentBlock {
  id        String           @id @default(cuid())
  siteId    String
  locale    String           @db.VarChar(5)
  sortOrder Int
  type      ContentBlockType
  textRole  TextRole?
  colorToken ColorToken?
  align     BlockAlign?
  listStyle ListStyle?
  spans     Json?
  mediaId   String?
  caption   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  site      Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  media     Media?           @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([siteId, locale, sortOrder])
  @@index([siteId, locale])
}

model QRCode {
  id          String       @id @default(cuid())
  siteId      String
  code        String       @unique
  installedAt DateTime     @default(now())
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  visitEvents VisitEvent[]

  @@index([siteId])
}

model VisitEvent {
  id         String       @id @default(cuid())
  siteId     String
  qrCodeId   String?
  locale     String       @db.VarChar(5)
  source     VisitSource
  deviceType String?
  createdAt  DateTime     @default(now())
  site       Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  qrCode     QRCode?      @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([qrCodeId])
  @@index([createdAt])
}

model User {
  id            String         @id @default(cuid())
  phone         String?        @unique
  email         String?        @unique
  passwordHash  String
  displayName   String?
  role          UserRole
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  reviews       SiteReview[]
  reviewLikes   SiteReviewLike[]
}

model SiteReview {
  id        String   @id @default(cuid())
  siteId    String
  userId    String
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     SiteReviewLike[]

  @@unique([siteId, userId])
  @@index([siteId])
  @@index([userId])
}

model SiteReviewLike {
  id        String     @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime   @default(now())
  review    SiteReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}
