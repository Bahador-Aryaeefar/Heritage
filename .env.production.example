# Copy to .env.production on the VPS (gitignored).
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# Strong password for Postgres (required).
POSTGRES_USER=heritage
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
POSTGRES_DB=heritage

# Public origin (TLS domain). Used for QR codes, upload URLs, and Next.js public env.
PUBLIC_SITE_URL=https://heritage.nobatix.ir

# Set false after first deploy if you prefer manual migrations.
RUN_MIGRATIONS=true

# Reverse-proxy hops trusted to set X-Forwarded-For (Express trust proxy).
# Caddy is the only reverse proxy in front of the API in this topology
# (docker-compose.prod.yml), so 1 is correct here. Do not set this higher
# than the real number of trusted hops: an inflated value lets a client
# spoof X-Forwarded-For and evade the auth rate limits.
TRUST_PROXY=1
